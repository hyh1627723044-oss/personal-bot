# Copy to .env. Keys, URLs, models and voice deliberately start empty.
# Voice engine: cascade (STT -> LLM -> TTS) | realtime (one audio model).
VOICE_ENGINE=cascade
# For realtime, set all five fields below; STT/LLM/TTS are not used for calls.
# Text-only mode still uses LLM_*.
# Qwen: provider=qwen, model=qwen-audio-3.0-realtime-plus (or ...-flash), voice=longanqian
# URL=wss://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# StepFun: provider=stepfun, model=stepaudio-3-realtime-preview,
# voice=soft-spoken-gentleman, URL=wss://api.stepfun.ai/v1/realtime
# Model/voice availability depends on your account and region. See docs/realtime.md.
REALTIME_PROVIDER=
REALTIME_API_KEY=
REALTIME_MODEL=
REALTIME_BASE_URL=
REALTIME_VOICE=

# STT: openai | deepgram
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=
STT_BASE_URL=

# LLM: openai | openai-compatible
# For openai-compatible, LLM_BASE_URL is required (usually ends in /v1).
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# TTS: openai | cartesia
# TTS_BASE_URL is supported by the openai adapter only.
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_BASE_URL=

LANGUAGE=zh
SYSTEM_PROMPT="你是一位友好、耐心的个人语音助手。使用简体中文自然交流，每次回答尽量简洁，适合朗读，不使用 Markdown 格式。"

# Local development needs no ICE servers. Supply a JSON array for remote use.
# ICE_SERVERS='[{"urls":"stun:your-host:3478"},{"urls":"turn:your-host:3478","username":"user","credential":"password"}]'
ICE_SERVERS=[]
MAX_SESSIONS=2
SESSION_TIMEOUT_SECONDS=1800
